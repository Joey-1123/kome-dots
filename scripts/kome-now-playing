#!/usr/bin/env bash
# kome-now-playing — get current media info for lock screen

set -euo pipefail

case "${1:-}" in
    pause)
        playerctl --player="$(kome-active-player)" status 2>/dev/null | grep -q Playing && echo "󰏤" || echo "󰐊"
        ;;
    *)
        playerctl --player="$(kome-active-player)" metadata --format '{{title}} · {{artist}}' 2>/dev/null || echo "No media"
        ;;
esac