#!/usr/bin/env bash
# kome-mpris-marquee — scrolling media title for waybar (from 43PR pattern)

set -euo pipefail

PLAYER="$(kome-active-player 2>/dev/null || echo "")"
[[ -z "$PLAYER" ]] && { echo '{"text": "", "alt": ""}'; exit 0; }

STATUS=$(playerctl --player="$PLAYER" status 2>/dev/null || echo "Stopped")
[[ "$STATUS" != "Playing" ]] && { echo '{"text": "", "alt": ""}'; exit 0; }

META=$(playerctl --player="$PLAYER" metadata --format '{{title}} · {{artist}}' 2>/dev/null || echo "")
[[ -z "$META" ]] && { echo '{"text": "", "alt": ""}'; exit 0; }

# Truncate if too long
MAX_LEN=50
if [[ ${#META} -gt $MAX_LEN ]]; then
    META="${META:0:$MAX_LEN}…"
fi

# Output JSON for waybar
jq -nc --arg text "$META" --arg tooltip "$META" --arg class "playing" '{text: $text, tooltip: $tooltip, class: $class}'