#!/usr/bin/env bash
# kome-bar — toggle/restart status bar.

set -euo pipefail

KOME_STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kome"
PROVIDERS_FILE="${KOME_STATE_DIR}/providers.env"

# shellcheck disable=SC1090
if [[ -f "$PROVIDERS_FILE" ]]; then source "$PROVIDERS_FILE"; fi

# waybar's style.css imports the generated palette, so a fresh install has no
# colours to style with until kome-theme has run at least once.
ensure_palette() {
    local colors="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/theme.css"
    [[ -f "$colors" ]] && return 0
    kome-theme apply >/dev/null 2>&1 || true
}

case "${1:-toggle}" in
    toggle)
        case "${KOME_BAR:-waybar}" in
            waybar)
                if pgrep -x waybar >/dev/null; then
                    pkill waybar
                else
                    ensure_palette
                    waybar &
                fi
                ;;
            quickshell)
                if pgrep -x quickshell >/dev/null; then
                    pkill quickshell
                else
                    quickshell -c shell.qml &
                fi
                ;;
        esac
        ;;
    restart)
        case "${KOME_BAR:-waybar}" in
            waybar) ensure_palette; pkill waybar; waybar & ;;
            quickshell) pkill quickshell; quickshell -c shell.qml & ;;
        esac
        ;;
    *) echo "Usage: $0 {toggle|restart}"; exit 1 ;;
esac