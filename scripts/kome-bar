#!/usr/bin/env bash
# kome-bar — toggle/restart status bar.

set -euo pipefail

KOME_STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kome"
PROVIDERS_FILE="${KOME_STATE_DIR}/providers.env"

# shellcheck disable=SC1090
if [[ -f "$PROVIDERS_FILE" ]]; then source "$PROVIDERS_FILE"; fi

# waybar's style.css imports the generated palette, so a fresh install has no
# colours to style with until kome-theme has run at least once.
ensure_palette() {
    local colors="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/theme.css"
    [[ -f "$colors" ]] && return 0
    kome-theme apply >/dev/null 2>&1 || true
}

# stop_bar <name> — pkill returns 1 when nothing matched, which under `set -e`
# would abort the script and leave the bar down. Treat it as a no-op.
stop_bar() {
    pkill -x "$1" 2>/dev/null || true
}

# start_bar <command> — setsid so the bar survives the shell that asked for it.
# Without it, `kome-bar toggle` from a terminal leaves the bar dead as soon as
# that terminal exits. kome-session starts its components the same way.
start_bar() {
    setsid bash -c "$1" >/dev/null 2>&1 &
}

case "${1:-toggle}" in
    toggle)
        case "${KOME_BAR:-waybar}" in
            waybar)
                if pgrep -x waybar >/dev/null; then
                    stop_bar waybar
                else
                    ensure_palette
                    start_bar waybar
                fi
                ;;
            quickshell)
                if pgrep -x quickshell >/dev/null; then
                    stop_bar quickshell
                else
                    start_bar "quickshell -c shell.qml"
                fi
                ;;
        esac
        ;;
    restart)
        case "${KOME_BAR:-waybar}" in
            waybar) ensure_palette; stop_bar waybar; start_bar waybar ;;
            quickshell) stop_bar quickshell; start_bar "quickshell -c shell.qml" ;;
        esac
        ;;
    *) echo "Usage: $0 {toggle|restart}"; exit 1 ;;
esac