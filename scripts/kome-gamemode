#!/usr/bin/env bash
# kome-gamemode — toggle compositor effects for games.
# Usage: kome-gamemode [{on|off|toggle}]   (default: toggle)
# Uses `hyprctl eval` (Lua configs reject `keyword`).
# Saves current state under $STATE_DIR so off restores exactly.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kome"
STATE_FILE="${STATE_DIR}/gamemode"
KEYS="animations:enabled decoration:blur:enabled decoration:shadow:enabled decoration:rounding"

hypr_ok() { hyprctl version >/dev/null 2>&1; }

# lua_path <colon-key> — animations:enabled -> animations.enabled
lua_path() { printf '%s' "${1//:/.}"; }

current_lua() {
    local key="$1"
    hyprctl getoption "$key" -j 2>/dev/null | jq -r 'if .int != null then (.int | tostring) elif .float != null then (.float | tostring) elif .bool == true then "true" elif .bool == false then "false" else empty end' 2>/dev/null || true
}

# set_nested <dotted-path> <lua-value> — emits hl.config({...}) via eval.
set_nested() {
    local path="$1" value="$2" lua=""
    local IFS='.'
    local -a parts
    read -r -a parts <<<"$path"
    local i open="" close=""
    for ((i = 0; i < ${#parts[@]} - 1; i++)); do
        open+="${parts[$i]} = { "
        close+=" }"
    done
    lua="hl.config({ ${open}${parts[-1]} = ${value}${close} })"
    hyprctl eval "$lua" >/dev/null 2>&1
}

cmd_on() {
    mkdir -p "$STATE_DIR"
    : >"$STATE_FILE"
    local key val
    for key in $KEYS; do
        val="$(current_lua "$key")"
        [[ -n "$val" ]] || continue
        printf '%s %s\n' "$(lua_path "$key")" "$val" >>"$STATE_FILE"
    done
    set_nested "animations.enabled" "false"
    set_nested "decoration.blur.enabled" "false"
    set_nested "decoration.shadow.enabled" "false"
    set_nested "decoration.rounding" "0"
    notify-send "Game mode on" 2>/dev/null || true
}

cmd_off() {
    if [[ -f "$STATE_FILE" ]]; then
        local path val
        while read -r path val; do
            [[ -n "$path" && -n "$val" ]] && set_nested "$path" "$val"
        done <"$STATE_FILE"
        rm -f "$STATE_FILE"
    else
        set_nested "animations.enabled" "true"
        set_nested "decoration.blur.enabled" "true"
        set_nested "decoration.shadow.enabled" "true"
    fi
    notify-send "Game mode off" 2>/dev/null || true
}

case "${1:-toggle}" in
    on) hypr_ok && cmd_on || { echo "hyprland not running" >&2; exit 1; } ;;
    off) hypr_ok && cmd_off || { echo "hyprland not running" >&2; exit 1; } ;;
    toggle)
        hypr_ok || { echo "hyprland not running" >&2; exit 1; }
        if [[ -f "$STATE_FILE" ]]; then cmd_off; else cmd_on; fi
        ;;
    *) echo "Usage: $0 [{on|off|toggle}]"; exit 1 ;;
esac
