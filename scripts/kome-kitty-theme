#!/usr/bin/env bash
# kome-kitty-theme — list and apply the vendored Kitty theme library.
set -euo pipefail

KITTY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
THEME_DIR="$KITTY_DIR/themes"
ACTIVE_THEME="$KITTY_DIR/theme.conf"
GENERATED_COLORS="$KITTY_DIR/colors.conf"

usage() {
    cat <<'EOF'
kome-kitty-theme — manage Kitty color themes

Usage:
  kome-kitty-theme list [--json]
  kome-kitty-theme current
  kome-kitty-theme apply <theme>
  kome-kitty-theme reset
  kome-kitty-theme path <theme>
EOF
}

list_themes() {
    if [[ ! -d "$THEME_DIR" ]]; then
        return 0
    fi
    find -L "$THEME_DIR" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' \
        | sed 's/\.conf$//' \
        | sort
}

# color_of <file> <key> — read one #rrggbb value from a kitty colour file.
color_of() {
    local value=""
    if [[ -f "$1" ]]; then
        value="$(sed -n -E "s/^[[:space:]]*$2[[:space:]]+(#[0-9a-fA-F]{6}).*/\1/p" "$1" | head -1)"
    fi
    printf '%s' "$value"
}

# list_themes_json — the generated palette first, then every vendored theme.
list_themes_json() {
    printf '[{"name":"generated","background":"%s","foreground":"%s","cursor":"%s"}' \
        "$(color_of "$GENERATED_COLORS" background)" \
        "$(color_of "$GENERATED_COLORS" foreground)" \
        "$(color_of "$GENERATED_COLORS" cursor)"
    local name file
    while IFS= read -r name; do
        file="$THEME_DIR/$name.conf"
        printf ',{"name":"%s","background":"%s","foreground":"%s","cursor":"%s"}' \
            "$name" \
            "$(color_of "$file" background)" \
            "$(color_of "$file" foreground)" \
            "$(color_of "$file" cursor)"
    done < <(list_themes)
    printf ']\n'
}

# resolve_active — follow theme.conf symlinks and include directives.
resolve_active() {
    local file="$ACTIVE_THEME" target include next depth=0 found=0
    while [[ $depth -lt 4 ]]; do
        if [[ -L "$file" ]]; then
            target="$(readlink -f "$file" 2>/dev/null || true)"
            [[ -n "$target" && -f "$target" ]] || break
            file="$target"
        fi
        [[ -f "$file" ]] || break
        found=1
        if [[ "$(basename "$(dirname "$file")")" == "themes" ]]; then
            basename "$file" .conf
            return 0
        fi
        include="$(sed -n -E 's/^[[:space:]]*include[[:space:]]+([^[:space:]]+).*/\1/p' "$file" | tail -1)"
        [[ -n "$include" ]] || break
        case "$include" in
            /*) next="$include" ;;
            *) next="$(dirname "$file")/$include" ;;
        esac
        file="$next"
        depth=$((depth + 1))
    done
    # A theme.conf with no include carries no colours, so kitty.conf keeps the
    # generated palette it already included; a missing theme.conf is unknown.
    if [[ $found -eq 1 ]]; then
        printf '%s\n' generated
    else
        printf '%s\n' unknown
    fi
}

validate_theme() {
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || {
        printf 'invalid theme name: %s\n' "$name" >&2
        return 1
    }
    [[ -f "$THEME_DIR/$name.conf" ]] || {
        printf 'unknown theme: %s\n' "$name" >&2
        printf 'available themes:\n' >&2
        list_themes >&2
        return 1
    }
}

apply_theme() {
    local name="$1"
    validate_theme "$name"
    mkdir -p "$KITTY_DIR"
    ln -sfn "$THEME_DIR/$name.conf" "$ACTIVE_THEME"
    if command -v kitty >/dev/null 2>&1 \
        && kitty @ set-colors --all --configured "$THEME_DIR/$name.conf" >/dev/null 2>&1; then
        printf 'applied %s to running Kitty windows\n' "$name"
    else
        printf 'applied %s for new Kitty windows (remote control unavailable)\n' "$name"
    fi
}

reset_theme() {
    mkdir -p "$KITTY_DIR"
    rm -f "$ACTIVE_THEME"
    # No include here: kitty.conf already included colors.conf, and including it
    # twice is a config error.
    printf '%s\n' \
        '# Generated Kome palette: kitty.conf includes colors.conf directly.' \
        >"$ACTIVE_THEME"
    if command -v kitty >/dev/null 2>&1 && [[ -f "$GENERATED_COLORS" ]] \
        && kitty @ set-colors --all --configured "$GENERATED_COLORS" >/dev/null 2>&1; then
        printf '%s\n' 'reset to the generated Kome palette'
    else
        printf '%s\n' 'reset to the generated Kome palette for new Kitty windows'
    fi
}

case "${1:-list}" in
list)
    if [[ "${2:-}" == "--json" ]]; then
        list_themes_json
    else
        list_themes
    fi
    ;;
current)
    resolve_active
    ;;
apply)
    [[ $# -eq 2 ]] || { usage >&2; exit 1; }
    apply_theme "$2"
    ;;
reset)
    [[ $# -eq 1 ]] || { usage >&2; exit 1; }
    reset_theme
    ;;
path)
    [[ $# -eq 2 ]] || { usage >&2; exit 1; }
    validate_theme "$2"
    printf '%s\n' "$THEME_DIR/$2.conf"
    ;;
help|-h|--help)
    usage
    ;;
*)
    usage >&2
    exit 1
    ;;
esac
