#!/usr/bin/env bash
# kome-workspace — switch Hyprland workspaces.
# Usage: kome-workspace {next|prev|<id>}

set -euo pipefail

active() {
    hyprctl -j activeworkspace 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])'
}

count() {
    hyprctl -j workspaces 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))'
}

# This Hyprland takes Lua dispatchers, not keyword strings: `hyprctl dispatch
# workspacenext` is a parse error, so every switch goes through hl.dsp.focus.
focus() {
    hyprctl dispatch "hl.dsp.focus({ workspace = $1 })" >/dev/null
}

case "${1:-next}" in
    next|prev)
        current="$(active)"
        total="$(count)"
        (( total > 0 )) || exit 0
        if [[ "$1" == "next" ]]; then
            target=$(( current % total + 1 ))
        else
            target=$(( (current - 2 + total) % total + 1 ))
        fi
        focus "$target"
        printf '%s\n' "$target"
        ;;
    ''|*[!0-9]*)
        printf 'usage: kome-workspace {next|prev|<id>}\n' >&2
        exit 1
        ;;
    *)
        focus "$1"
        printf '%s\n' "$1"
        ;;
esac
