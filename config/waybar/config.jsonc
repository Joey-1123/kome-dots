// kome — waybar. Enhanced with modules from 43PR/dotfiles.
// Colors from theme.css (generated by matugen).
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mpris-marquee", "pulseaudio", "network", "battery", "cpu", "memory", "tray"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "",
            "active": "",
            "empty": ""
        }
    },
    "hyprland/submap": {
        "format": "{}",
        "tooltip": false
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
        "on-click": "kome-theme toggle"
    },
    "custom/mpris-marquee": {
        "exec": "kome-mpris-marquee",
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl --player=\"$(kome-active-player)\" play-pause",
        "on-click-right": "playerctl --player=\"$(kome-active-player)\" next",
        "on-click-middle": "playerctl --player=\"$(kome-active-player)\" previous"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "Muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "cpu": { "interval": 5, "format": " {usage}%" },
    "memory": { "interval": 10, "format": " {used:0.1f}G" },
    "tray": { "icon-size": 16, "spacing": 8 }
}