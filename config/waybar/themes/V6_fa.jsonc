/* kome layout generated from waybar-themes V6.fa (MIT), drdeltree.
 * Upstream module list, order, and formatting are kept; omarchy-only
 * modules and click handlers are replaced or dropped, and the modules that
 * need wttrbar or waybar-module-pacman-updates get an exec-if guard so the
 * bar stays clean until those packages are installed. Rebuild with
 * scripts/build-bar-layouts.py. See THIRD_PARTY_NOTICES.md.
 * kome-bar-theme: needs=waybar-module-pacman-updates */
{
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "top",
    "spacing": 0,
    "height": 15,
    "margin-top": 0,
    "modules-left": [
        "group/left1",
        "group/left2",
        "group/left3",
        "group/left4"
    ],
    "group/left1": {
        "orientation": "inherit",
        "modules": [
            "clock",
            "idle_inhibitor",
            "custom/screenrecording-indicator",
            "custom/updatespacman"
        ]
    },
    "group/left2": {
        "orientation": "inherit",
        "modules": [
            "tray"
        ]
    },
    "group/left3": {
        "orientation": "inherit",
        "modules": []
    },
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "group/right2",
        "group/right1"
    ],
    "group/right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network",
            "bluetooth",
            "pulseaudio#output",
            "pulseaudio#input",
            "power-profiles-daemon",
            "memory",
            "cpu",
            "battery"
        ]
    },
    "group/right2": {
        "orientation": "inherit",
        "modules": [
            "mpris"
        ]
    },
    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5,
                6
            ]
        },
        "on-click": "activate",
        "format": "{icon} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<.*imv*.>": "",
            "class<.*bambustudio*.>": "󰐫",
            "class<.*bitwarden*.>": "",
            "class<.*handbrake*.>": "󰈫",
            "class<.*stremio*.>": "󱖏",
            "title<.*waydroid*.>": "",
            "class<.*grayjay*.>": "󱗆",
            "title<.*amazon.*>": "",
            "class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": "",
            "class<zen>": "󰰷",
            "class<waterfox|waterfox-bin>": "",
            "class<microsoft-edge>": "",
            "class<Chromium|Thorium|[Cc]hrome>": "",
            "class<brave-browser>": "🦁",
            "class<tor-browser>": "",
            "class<firefox-developer-edition>": "🦊",
            "class<kitty|konsole>": "",
            "class<kitty-dropterm>": "",
            "class<com.mitchellh.ghostty>": "",
            "class<org.wezfurlong.wezterm>": "",
            "class<org.omarchy.terminal>": "󰏖",
            "class<[Tt]hunderbird|[Tt]hunderbird-esr>": "",
            "class<eu.betterbird.Betterbird>": "",
            "title<.*gmail.*>": "󰊫",
            "class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "",
            "class<discord|[Ww]ebcord|Vesktop>": "",
            "title<.*whatsapp.*>": "",
            "title<.*zapzap.*>": "",
            "title<.*messenger.*>": "",
            "title<.*facebook.*>": " ",
            "title<.*reddit.*>": "",
            "title<.*ChatGPT.*>": "󰚩",
            "class<.*ChatGPT.*>": "󰚩",
            "title<.*deepseek.*>": "󰚩",
            "title<.*qwen.*>": "󰚩",
            "class<subl>": "󰅳",
            "class<slack>": "",
            "class<mpv>": "",
            "class<celluloid|Zoom>": "",
            "class<Cider>": "󰎆 ",
            "title<.*Picture-in-Picture.*>": "",
            "title<.*youtube.*>": "",
            "class<vlc>": "󰕼",
            "title<.*cmus.*>": "",
            "class<[Ss]potify>": "",
            "class<virt-macodeger>": "",
            "class<.virt-manager-wrapped>": "",
            "class<virtualbox manager>": "💽",
            "title<virtualbox>": "💽",
            "class<remmina>": "🖥️",
            "class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "󰨞",
            "class<dev.zed.Zed>": "󰵁",
            "class<codeblocks>": "󰅩",
            "title<.*github.*>": "",
            "class<mousepad>": "",
            "class<libreoffice-writer>": "",
            "class<libreoffice-startcenter>": " 󰏆",
            "class<libreoffice-calc>": "",
            "title<.*nvim ~.*>": "",
            "class<org.gnome.Nautilus>": "󰣆",
            "title<.*vim.*>": "",
            "title<.*figma.*>": "",
            "title<.*jira.*>": "",
            "class<jetbrains-idea>": "",
            "title<*.VSCode.*>": "󰨞",
            "class<.*code.*>": "󰨞",
            "class<obs|com.obsproject.Studio>": "",
            "class<polkit-gnome-authentication-agent-1>": "󰒃",
            "class<nwg-look>": "",
            "class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫",
            "class<steam>": "",
            "class<thunar|nemo>": "󰝰",
            "class<Gparted>": "",
            "class<gimp>": "",
            "class<emulator>": "📱",
            "class<android-studio>": "",
            "class<org.pipewire.Helvum>": "󰓃",
            "class<localsend>": "",
            "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛"
        },
        "on-scroll-up": "kome-workspace next",
        "on-scroll-down": "kome-workspace prev"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛊",
            "deactivated": "󰾪"
        }
    },
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "on-click": "kome-hub-page system"
    },
    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "on-click": "kome-hub-page system"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": [
            "🌑",
            "🌘",
            "🌗",
            "🌖",
            "🌕"
        ],
        "on-click": "kome-brightness toggle",
        "on-scroll-up": "kome-brightness up",
        "on-scroll-down": "kome-brightness down"
    },
    "clock": {
        "format": " {:%H:%M %d/%m/%Y}",
        "format-alt": "{:L%d %B W%V %Y}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        }
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "kome-hub-page network"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅 {capacity}%",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "on-click": "kome-hub-page kome",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "kome-hub-page bluetooth"
    },
    "pulseaudio#input": {
        "format-source": "",
        "format-source-muted": " ",
        "format": "{format_source}",
        "tooltip-format": "{format_source} {source_volume}%",
        "scroll-step": 1,
        "smooth-scrolling-threshold": 1,
        "max-volume": 100,
        "on-click": "kome-hub-page audio",
        "on-scroll-up": "wpctl set-volume -l 125 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },
    "pulseaudio#output": {
        "format": "{icon}",
        "tooltip-format": "{icon}  {volume}%",
        "format-muted": " off",
        "format-icons": {
            "default": [
                ""
            ]
        },
        "max-volume": 100,
        "scroll-step": 2,
        "smooth-scrolling-threshold": 1,
        "on-click": "kome-hub-page audio",
        "on-scroll-up": "wpctl set-volume -l 125 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰓅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },
    "mpris": {
        "format": "󰋎 {artist}-{title}",
        "format-paused": "<i><span color='grey'>{status_icon} {artist}</span></i>",
        "max-length": 30,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "󰋐"
        },
        "ignored-players": [
            "firefox",
            "chromium",
            "brave"
        ]
    },
    "custom/updatespacman": {
        "format": "{}{icon}",
        "return-type": "json",
        "format-icons": {
            "has-updates": " 󰏖",
            "updated": ""
        },
        "exec-if": "which waybar-module-pacman-updates",
        "exec": "waybar-module-pacman-updates --no-zero-output",
        "on-click": "kome-hub-page updates"
    },
    "custom/screenrecording-indicator": {
        "exec": "test -f /tmp/kome-gsr.pid && printf 'REC' || printf ''",
        "tooltip": true,
        "tooltip-format": "Toggle screen recording",
        "on-click": "kome-record",
        "on-click-right": "kome-record"
    },
    "tray": {
        "icon-size": 11,
        "spacing": 5,
        "show-passive-items": true
    }
}
