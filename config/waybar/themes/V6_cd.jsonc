/* kome layout generated from waybar-themes V6.cd (MIT), drdeltree.
 * Upstream module list, order, and formatting are kept; omarchy-only
 * modules and click handlers are replaced or dropped, and the modules that
 * need wttrbar or waybar-module-pacman-updates get an exec-if guard so the
 * bar stays clean until those packages are installed. Rebuild with
 * scripts/build-bar-layouts.py. See THIRD_PARTY_NOTICES.md.
 * kome-bar-theme: needs=waybar-module-pacman-updates */
{
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "top",
    "margin-top": 0,
    "spacing": 0,
    "height": 0,
    "margin-bottom": 0,
    "modules-left": [
        "hyprland/workspaces",
        "custom/separator",
        "idle_inhibitor",
        "custom/screenrecording-indicator",
        "custom/updatespacman"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "group/tray-expander",
        "custom/separator",
        "pulseaudio",
        "memory",
        "cpu",
        "battery",
        "custom/separator",
        "clock"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "cursor": true,
        "format": "{icon}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "7": [],
            "8": [],
            "9": [],
            "10": []
        },
        "on-scroll-up": "kome-workspace next",
        "on-scroll-down": "kome-workspace prev"
    },
    "custom/separator": {
        "format": "|",
        "tooltip": false
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "cpu": {
        "interval": 10,
        "format": "cpu {usage}%",
        "on-click": "kome-hub-page system"
    },
    "backlight": {
        "device": "intel_backlight",
        "rotate": 0,
        "format": "{icon}",
        "tooltip-format": "🌕 {percent}%",
        "format-icons": [
            "󰃜",
            "󰃝",
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "scroll-step": 1,
        "min-length": 2,
        "on-click": "kome-brightness toggle",
        "on-scroll-up": "kome-brightness up",
        "on-scroll-down": "kome-brightness down"
    },
    "memory": {
        "interval": 2,
        "format": "mem {used:0.1f}gb",
        "on-click": "kome-hub-page system"
    },
    "clock": {
        "format": "{:%d/%m - %H:%M}",
        "format-alt": "{:L%d %B W%V %Y}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        }
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰌗",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "kome-hub-page network"
    },
    "battery": {
        "format": "bat {capacity}%",
        "format-discharging": "bat {capacity}%",
        "format-charging": "bat {capacity}%",
        "format-plugged": "bat_p {capacity}%",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "bat_f {capacity}%",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "on-click": "kome-hub-page kome",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "kome-hub-page bluetooth"
    },
    "pulseaudio": {
        "format": "vol {volume}%",
        "on-click": "kome-hub-page audio",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-scroll-up": "wpctl set-volume -l 125 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "mpris": {
        "format": " {artist} - {title}",
        "format-paused": "<span color='grey'>{status_icon}</span>",
        "max-length": 75,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "󰝛"
        },
        "ignored-players": [
            "firefox",
            "chromium",
            "brave"
        ]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": "󰾫"
        }
    },
    "custom/updatespacman": {
        "format": "{}{icon}",
        "return-type": "json",
        "format-icons": {
            "has-updates": " 󰏖",
            "updated": ""
        },
        "exec-if": "which waybar-module-pacman-updates",
        "exec": "waybar-module-pacman-updates --no-zero-output",
        "on-click": "kome-hub-page updates"
    },
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item"
        },
        "modules": [
            "tray",
            "custom/separator",
            "power-profiles-daemon",
            "network",
            "backlight",
            "bluetooth"
        ]
    },
    "tray": {
        "icon-size": 12,
        "spacing": 4
    },
    "custom/screenrecording-indicator": {
        "exec": "test -f /tmp/kome-gsr.pid && printf 'REC' || printf ''",
        "tooltip": true,
        "tooltip-format": "Toggle screen recording",
        "on-click": "kome-record",
        "on-click-right": "kome-record"
    }
}
