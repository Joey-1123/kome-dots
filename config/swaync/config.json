{
    "layer": "top",
    "control-center-layer": "top",
    "css-priority": "application",
    "notification-window-width": 380,
    "notification-window-height": 120,
    "notification-icon-size": 48,
    "notification-body-image-height": 100,
    "notification-body-image-width": 160,
    "timeout": 8,
    "timeout-low": 6,
    "timeout-critical": 0,
    "fit-to-screen": true,
    "control-center-width": 480,
    "control-center-height": 600,
    "control-center-margin-top": 60,
    "control-center-margin-bottom": 20,
    "control-center-margin-left": 20,
    "control-center-margin-right": 20,
    "widgets": [
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "volume": {
            "label": "Volume",
            "tooltip": true
        },
        "backlight": {
            "label": "Brightness",
            "tooltip": true
        }
    }
}